# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ATENTIE: aceasta cheie NU se pune niciodata in cod, in git, sau in NEXT_PUBLIC_*
# Se ia din Supabase Dashboard -> Project Settings -> API -> service_role (secret)
# Are acces total la baza de date si ocoleste RLS -- se foloseste DOAR in
# fisiere server-side (route.ts, page.tsx fara "use client")
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com -> API Keys)
RESEND_API_KEY=

# Adresa de la care pleaca emailurile de reclamatie -- trebuie sa fie pe un
# domeniu verificat in Resend (nu poti trimite de pe "gmail.com" de exemplu)
RESEND_FROM_EMAIL=feedback@domeniul-tau.ro

# Adresa care primeste mesajele din formularul de contact (/api/contact).
# Optional -- daca lipseste, se foloseste contact@scanvogue.ro.
CONTACT_TO_EMAIL=

# Groq (groq.com -> API Keys) -- folosit pentru analiza AI a reclamatiilor
GROQ_API_KEY=

# Cheie separata folosita ca sa hash-uim IP-urile stocate pentru dedup de
# scanari si rate-limiting de reclamatii (vezi lib/request-meta.ts). Nu
# stocam niciodata IP-ul in clar -- doar hash-ul lui. Orice valoare lunga si
# aleatoare e buna; schimband-o mai tarziu, hash-urile vechi devin
# necomparabile cu cele noi (efect secundar minor, nu o problema).
IP_HASH_SECRET=

# Secrete pentru job-urile cron (GitHub Actions -> Settings -> Secrets).
# Fiecare job are propriul secret, ca sa limitam ce se poate declansa daca
# unul dintre ele e vreodata compromis.
WEEKLY_THEMES_SECRET=
MONTHLY_REPORT_SECRET=
CLIENT_LOOP_SECRET=
DATA_RETENTION_SECRET=
